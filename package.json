{
  "name": "checkout-coverage-lab",
  "private": true,
  "version": "1.0.0",
    "author": {
    "name": "Ash Coca",
    "email": "ashvincoca@gmail.com",
    "url": "http://www.ashcoca.com/"
  },
  "type": "module",
  "description": "A tiny shop app + GitHub Actions pipeline for teaching code coverage. CI stays red until the suite covers 80% of checkout.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}

